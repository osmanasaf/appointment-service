# WhatsApp Cloud API Configuration
# Meta Business Suite'den alınacak değerler
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=meta-cloud
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_WABA_ID=your_whatsapp_business_account_id
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_API_VERSION=v20.0

# Rate Limiting
RATELIMIT_ENABLED=true
RATELIMIT_AUTH_RPM=10
RATELIMIT_PUBLIC_RPM=30
RATELIMIT_WEBHOOK_RPM=100

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
APP_EMAIL_FROM=noreply@ayarla.tr
APP_BASE_URL=http://localhost:5173

# SMS Fallback (optional)
APP_SMS_ENABLED=false
APP_SMS_FROM=

# Security
APP_ENCRYPTION_SECRET_KEY=ChangeMeInProduction32Bytes!!

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
